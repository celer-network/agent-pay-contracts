# Copy to `.env` (gitignored) and fill in. Load for a session via:
#   set -a; source script/.env; set +a

# Deployer private key (hex, with 0x prefix). Pays gas and becomes the initial
# Ownable owner of `AgentPayWallet` and `AgentPayLedger`.
PRIVATE_KEY=0x...

# RPC URL for the target network
RPC_URL=https://...

# Path to deployment config JSON (defaults to "config.json" if unset)
# DEPLOY_CONFIG=config.json

# Block explorer API key for contract verification with `--verify` (optional)
# ETHERSCAN_API_KEY=...
